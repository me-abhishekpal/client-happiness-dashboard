// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../../frontend/node_modules/.prisma/client"
}

// generator client_seed {
//   provider = "prisma-client-js"
// }

datasource db {
  provider = "sqlite" // Easy for MVP, switch to Postgres for Prod
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// USERS & ROLES
// --------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   // JSON string storing allowed route keys e.g. ["dashboard", "admin_users"]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          String    @default("VIEWER") // "ADMIN", "EXECUTIVE", "MANAGER", "VIEWER"
  title         String?   // "Project Manager", "VP", "Director"
  
  // RBAC Relation (New)
  roleId        String?
  roleRel       Role?     @relation(fields: [roleId], references: [id])
  
  // Org Hierarchy (New)
  titleId       String?
  titleRel      Title?    @relation(fields: [titleId], references: [id])
  
  managerId     String?
  manager       User?     @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]    @relation("UserManager")

  // Department Relationship
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  
  // Ownership
  managedClients Client[]  @relation("ClientOwner")
  accountableFor Client[]  @relation("ClientAccountable")
  
  // Audit Trail
  statusUpdates StatusUpdate[]
  
  // Files
  uploadedFiles File[]
  
  // Escalations
  ownedEscalations Escalation[]
  
  // Auth
  passwordHash      String?
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  mfaSecret         String?
  mfaEnabled        Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

// --------------------------------------------------------
// DEPARTMENTS & TITLES
// --------------------------------------------------------

model Title {
  id          String   @id @default(cuid())
  name        String   @unique // "Software Engineer", "VP of Sales"
  
  reportsToId String?
  reportsTo   Title?   @relation("TitleHierarchy", fields: [reportsToId], references: [id])
  directReportTitles Title[] @relation("TitleHierarchy")

  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String   // "MIS", "MSS", "MEA", "PMO", "CS", "AM"
  headId      String?  // Optional Head of Dept
  users       User[]
  clients     Client[]
}

// --------------------------------------------------------
// CLIENTS & STATUS
// --------------------------------------------------------

model Client {
  id          String    @id @default(cuid())
  name        String
  
  // Core Status
  status      String    @default("UNKNOWN") // "RED", "AMBER", "GREEN", "UNKNOWN"
  lastUpdated DateTime  @default(now())
  
  // Ownership
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  ownerId      String?
  owner        User?       @relation("ClientOwner", fields: [ownerId], references: [id])
  
  accountableId String?   // The "Accountability" person (e.g., Vertical Head)
  accountable   User?     @relation("ClientAccountable", fields: [accountableId], references: [id])

  // Team
  csmName     String?
  pmName      String?
  amName      String?
  vcisoName   String?
  resourceLink String?

  // Engagement Details
  serviceType       String? // "MSS", "ITO", "MEA"
  currentEngagement String? // "SOC", "ERP Mgmt", etc.
  engagementStatus  String? // "OPEN", "ONGOING", "CLOSED"
  
  // Comments & Actions
  nextSteps         String?
  csmPmComments     String?
  executiveComments String?

  // Evidence & Files
  evidenceFiles File[]    @relation("ClientFiles")
  
  // Escalations
  escalations   Escalation[]
  
  // Watchlist
  isOnWatchlist Boolean   @default(false)
  
  // History
  updates     StatusUpdate[]
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
}

model File {
  id        String   @id @default(cuid())
  name      String
  path      String   // Local path or URL
  type      String   // "EML", "MSG", "PDF", "IMG"
  
  clientId  String
  client    Client   @relation("ClientFiles", fields: [clientId], references: [id], onDelete: Cascade)
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  statusUpdateId String?
  statusUpdate   StatusUpdate? @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Escalation {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  title       String   // "CEO unhappy with delay"
  severity    String   // "HIGH", "MEDIUM", "LOW"
  status      String   // "OPEN", "RESOLVED"
  
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

// --------------------------------------------------------
// AUDIT LOG (The "Who Changed What")
// --------------------------------------------------------

model StatusUpdate {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  
  oldStatus String    // "RED", "AMBER", "GREEN"
  newStatus String
  
  comments  String?   // "Client upset about X"
  nextSteps String?   // "Scheduled call with VIP"
  
  files     File[]    // Evidence files attached to this update
  
  createdAt DateTime  @default(now())
}
