// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  output        = "../../frontend/node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// generator client_seed {
//   provider = "prisma-client-js"
// }

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------
// MULTI-TENANT ARCHITECTURE
// --------------------------------------------------------

model Tenant {
  id   String @id @default(cuid())
  slug String @unique // URL-safe: "acme-corp"
  name String // Display: "Acme Corporation"

  // Domain Configuration
  subdomain      String? @unique // "acme" -> acme.rag.abhee.org
  customDomain   String? @unique // "happiness.acme.com"
  domainVerified Boolean @default(false)

  // Email Domain Restriction
  allowedEmailDomain String? @unique // "oculusit.com" - Only this domain allowed

  // White-labeling (JSON fields)
  branding String? // JSON: { logo, primaryColor, secondaryColor, companyName }
  settings String? // JSON: { emailFrom, timezone, features }

  // Subscription
  plan   String @default("free") // "free", "pro", "enterprise"
  status String @default("active") // "active", "suspended", "cancelled"

  // Relations
  users         User[]
  clients       Client[]
  roles         Role[]
  titles        Title[]
  departments   Department[]
  statusUpdates StatusUpdate[]
  files         File[]
  escalations   Escalation[]
  services      Service[]
  engagements   Engagement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model SuperAdmin {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  mfaSecret    String?
  mfaEnabled   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------
// USERS & ROLES
// --------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  name        String
  description String?
  permissions String // JSON string storing allowed route keys e.g. ["dashboard", "admin_users"]
  users       User[]

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

model User {
  id    String  @id @default(cuid())
  email String
  name  String?
  role  String  @default("VIEWER") // "ADMIN", "EXECUTIVE", "MANAGER", "VIEWER"
  title String? // "Project Manager", "VP", "Director"

  // RBAC Relation (New)
  roleId  String?
  roleRel Role?   @relation(fields: [roleId], references: [id])

  // Org Hierarchy (New)
  titleId  String?
  titleRel Title?  @relation(fields: [titleId], references: [id])

  managerId     String?
  manager       User?   @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]  @relation("UserManager")

  // Department Relationship
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Ownership
  managedClients Client[] @relation("ClientOwner")
  accountableFor Client[] @relation("ClientAccountable")

  // Team Assignments
  csmClients     Client[] @relation("ClientCSM")
  pmClients      Client[] @relation("ClientPM")
  amClients      Client[] @relation("ClientAM")
  vcisoClients   Client[] @relation("ClientVCISO")

  // Audit Trail
  statusUpdates StatusUpdate[]

  // Files
  uploadedFiles File[]

  // Escalations
  ownedEscalations Escalation[]

  // Auth
  passwordHash      String?
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  mfaSecret         String?
  mfaEnabled        Boolean   @default(false)

  // Guest Access (for users outside tenant's email domain)
  isGuest Boolean @default(false) // True for view-only access without matching domain

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([email, tenantId])
  @@index([tenantId])
}

// --------------------------------------------------------
// DEPARTMENTS & TITLES
// --------------------------------------------------------

model Title {
  id   String @id @default(cuid())
  name String // "Software Engineer", "VP of Sales"

  reportsToId        String?
  reportsTo          Title?  @relation("TitleHierarchy", fields: [reportsToId], references: [id])
  directReportTitles Title[] @relation("TitleHierarchy")

  users User[]

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Department {
  id      String   @id @default(cuid())
  name    String // "MIS", "MSS", "MEA", "PMO", "CS", "AM"
  headId  String? // Optional Head of Dept
  users   User[]
  clients Client[]

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --------------------------------------------------------
// SERVICES & ENGAGEMENTS (Contracts)
// --------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  name        String   // e.g., "MSS", "ITO"
  description String?

  clients     Client[]
  engagements Engagement[] // implicit M2M via Prisma

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Engagement {
  id          String   @id @default(cuid())
  name        String   // e.g., "SOC", "ERP Mgmt"
  description String?

  // Many-to-many with Service (Prisma implicit M2M — auto-creates _EngagementToService junction)
  services    Service[]

  clients     Client[]

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

// --------------------------------------------------------
// CLIENTS & STATUS
// --------------------------------------------------------

model Client {
  id   String @id @default(cuid())
  name String

  // Core Status
  status      String   @default("UNKNOWN") // "RED", "AMBER", "GREEN", "UNKNOWN"
  lastUpdated DateTime @default(now())

  // Financials & Metrics
  revenue     Float?
  nps         Int?
  kudos       Int?

  // Ownership
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id])

  accountableId String? // The "Accountability" person (e.g., Vertical Head)
  accountable   User?   @relation("ClientAccountable", fields: [accountableId], references: [id])

  // Team Assignments (Relations to User)
  csmId        String?
  csm          User?   @relation("ClientCSM", fields: [csmId], references: [id])

  pmId         String?
  pm           User?   @relation("ClientPM", fields: [pmId], references: [id])

  amId         String?
  am           User?   @relation("ClientAM", fields: [amId], references: [id])

  vcisoId      String?
  vciso        User?   @relation("ClientVCISO", fields: [vcisoId], references: [id])

  // Engagement Details (Relations)
  serviceId         String?
  service           Service?     @relation(fields: [serviceId], references: [id])
  
  engagementId      String?
  currentEngagement Engagement?  @relation(fields: [engagementId], references: [id])
  
  engagementStatus  String? // "OPEN", "ONGOING", "CLOSED"

  // Comments & Actions
  nextSteps         String?
  csmPmComments     String?
  executiveComments String?
  resourceLink      String?

  // Evidence & Files
  evidenceFiles File[] @relation("ClientFiles")

  // Escalations
  escalations Escalation[]

  // Watchlist
  isOnWatchlist Boolean @default(false)

  // History
  updates StatusUpdate[]

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([tenantId])
  @@index([status, tenantId])
}

model File {
  id   String @id @default(cuid())
  name String
  path String // Local path or URL
  type String // "EML", "MSG", "PDF", "IMG"

  clientId String
  client   Client @relation("ClientFiles", fields: [clientId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  statusUpdateId String?
  statusUpdate   StatusUpdate? @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Escalation {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title    String // "CEO unhappy with delay"
  severity String // "HIGH", "MEDIUM", "LOW"
  status   String // "OPEN", "RESOLVED"

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([tenantId])
}

// --------------------------------------------------------
// AUDIT LOG (The "Who Changed What")
// --------------------------------------------------------

model StatusUpdate {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  oldStatus String // "RED", "AMBER", "GREEN"
  newStatus String

  comments  String? // "Client upset about X"
  nextSteps String? // "Scheduled call with VIP"

  files File[] // Evidence files attached to this update

  // Multi-Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
}
