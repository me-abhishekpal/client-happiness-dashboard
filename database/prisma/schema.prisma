// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Easy for MVP, switch to Postgres for Prod
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// USERS & ROLES
// --------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          String    @default("VIEWER") // "ADMIN", "EXECUTIVE", "MANAGER", "VIEWER"
  title         String?   // "Project Manager", "VP", "Director"
  
  // Department Relationship
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  
  // Ownership
  managedClients Client[]  @relation("ClientOwner")
  accountableFor Client[]  @relation("ClientAccountable")
  
  // Audit Trail
  statusUpdates StatusUpdate[]
  
  // Files
  uploadedFiles File[]
  
  // Escalations
  ownedEscalations Escalation[]
  
  // Auth
  passwordHash String?
  mfaSecret    String?
  mfaEnabled   Boolean @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// --------------------------------------------------------
// DEPARTMENTS
// --------------------------------------------------------

model Department {
  id          String   @id @default(cuid())
  name        String   // "MIS", "MSS", "MEA", "PMO", "CS", "AM"
  headId      String?  // Optional Head of Dept
  users       User[]
  clients     Client[]
}

// --------------------------------------------------------
// CLIENTS & STATUS
// --------------------------------------------------------

model Client {
  id          String    @id @default(cuid())
  name        String
  
  // Core Status
  status      String    @default("UNKNOWN") // "RED", "AMBER", "GREEN", "UNKNOWN"
  lastUpdated DateTime  @default(now())
  
  // Ownership
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  
  ownerId      String
  owner        User       @relation("ClientOwner", fields: [ownerId], references: [id])
  
  accountableId String?   // The "Accountability" person (e.g., Vertical Head)
  accountable   User?     @relation("ClientAccountable", fields: [accountableId], references: [id])

  // Engagement Details
  serviceType       String? // "MSS", "ITO", "MEA"
  currentEngagement String? // "SOC", "ERP Mgmt", etc.
  
  // Evidence & Files
  evidenceFiles File[]    @relation("ClientFiles")
  
  // Escalations
  escalations   Escalation[]
  
  // Watchlist
  isOnWatchlist Boolean   @default(false)
  
  // History
  updates     StatusUpdate[]
  createdAt   DateTime @default(now())
}

model File {
  id        String   @id @default(cuid())
  name      String
  path      String   // Local path or URL
  type      String   // "EML", "MSG", "PDF", "IMG"
  
  clientId  String
  client    Client   @relation("ClientFiles", fields: [clientId], references: [id], onDelete: Cascade)
  
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  createdAt DateTime @default(now())
}

model Escalation {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  title       String   // "CEO unhappy with delay"
  severity    String   // "HIGH", "MEDIUM", "LOW"
  status      String   // "OPEN", "RESOLVED"
  
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

// --------------------------------------------------------
// AUDIT LOG (The "Who Changed What")
// --------------------------------------------------------

model StatusUpdate {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  
  oldStatus String    // "RED", "AMBER", "GREEN"
  newStatus String
  
  comments  String?   // "Client upset about X"
  nextSteps String?   // "Scheduled call with VIP"
  
  createdAt DateTime  @default(now())
}
