# ============================================================
# Client Happiness Dashboard — Dev Environment Template
# Copy this to .env and fill in your local values.
# This file is SAFE to commit (no real secrets).
# ============================================================

# Application
NODE_ENV=development
APP_PORT=3000

# Authentication
NEXTAUTH_URL=http://localhost:3000
# Generate a dev secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# PostgreSQL (used by docker-compose.dev.yml)
POSTGRES_DB=client_happiness_dev
POSTGRES_USER=ch_dev
POSTGRES_PASSWORD=replace-me-with-a-dev-password

# Prisma (points to Postgres inside Docker)
DATABASE_URL=postgresql://ch_dev:replace-me-with-a-dev-password@localhost:5432/client_happiness_dev

# Email (can use Mailtrap or Ethereal for dev — https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me

# Cloudflare Tunnel (not needed for local dev — leave empty or comment out)
# CLOUDFLARE_TUNNEL_TOKEN=
